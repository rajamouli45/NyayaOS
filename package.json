{
    "name": "nyayaos",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "node platform/index.js",
        "api": "node packages/api/src/index.js",
        "build": "tsc --build",
        "lint": "turbo run lint --continue",
        "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
        "typecheck": "turbo run typecheck",
        "validate-terms": "node scripts/validate_terminology.js"
    },
    "imports": {
        "#contracts": "./packages/contracts/dist/index.js",
        "#agents": "./agents/dist/plugins/index.js"
    },
    "devDependencies": {
        "typescript": "^5.7.2",
        "turbo": "^2.3.3",
        "prettier": "^3.4.2",
        "eslint": "^9.17.0"
    }
}